<!-- ON-CHAIN DASHBOARD -->
<div class="page" id="onchain-page">
  <div class="dash-wrap">
    <nav class="topnav">
      <div class="nav-left"><div class="nav-logo"><div class="nav-logo-icon">🛡️</div><div class="nav-logo-text">ZKML DEFENSE IDS</div></div><div class="nav-mode-badge on">⛓️ ON-CHAIN</div></div>
